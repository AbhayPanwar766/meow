return {
    "mfussenegger/nvim-dap",
    dependencies = {
        "rcarriga/nvim-dap-ui",
        "theHamsta/nvim-dap-virtual-text",
        "nvim-neotest/nvim-nio",
    },
    config = function()
        local dap = require("dap")
        local dapui = require("dapui")

        dapui.setup()
        require("nvim-dap-virtual-text").setup()

        -- Forces interactive debugger console splits to reuse a clean bottom line
        dap.defaults.fallback.terminal_win_cmd = "belowright 12split new"

        -- Automatically open UI panels when debugging starts
        dap.listeners.before.attach.dapui_config = function()
            dapui.open()
        end
        dap.listeners.before.launch.dapui_config = function()
            dapui.open()
        end
        -- OPTIMIZATION: Removed auto-close listeners so variable panes stay
        -- frozen open for inspection after code finish execution profiles end.

        -- C++ Adapter config pointing to Mason path
        dap.adapters.codelldb = {
            type = "server",
            port = "${port}",
            executable = {
                command = vim.fn.stdpath("data") .. "/mason/bin/codelldb",
                args = { "--port", "${port}" },
            },
        }

        -- C++ Launch settings tailored for single-file competitive programming
        --[[   dap.configurations.cpp = {
            {
                name = "Compile & Debug Current File",
                type = "codelldb",
                request = "launch",
                program = function()
                    -- Save the current file first
                    vim.cmd("w")

                    local current_file = vim.fn.expand("%") -- solution.cpp
                    local executable = vim.fn.expand("%:r") -- solution (no extension)

                    -- Compile command using modern C++ standards alongside debug symbols (-g)
                    local compile_cmd = string.format("g++ -std=c++20 -g %s -o %s", current_file, executable)

                    print("Compiling with debug symbols...")
                    local result = vim.fn.system(compile_cmd)

                    -- FIX 1: If compilation fails, show notification and return nil to halt smoothly
                    if vim.v.shell_error ~= 0 then
                        vim.notify("Compilation failed:\n" .. result, vim.log.levels.ERROR)
                        return nil
                    end

                    -- Return the absolute path of the compiled program to start debugging
                    return vim.fn.getcwd() .. "/" .. executable
                end,
                -- FIX 3: Fallback seamlessly if not inside a strict project workspace root folder
                cwd = function()
                    return vim.fn.getcwd()
                end,
                stopOnEntry = false,
                runInTerminal = true,
            },
        }
        dap.configurations.c = dap.configurations.cpp --]]

        -- C++ Launch settings tailored for single-file competitive programming
        dap.configurations.cpp = {
            {
                name = "Compile & Debug Current File",
                type = "codelldb",
                request = "launch",
                program = function()
                    -- Save the current file first
                    vim.cmd("w")

                    local current_file = vim.fn.expand("%") -- solution.cpp
                    local executable = vim.fn.expand("%:r") -- solution (no extension)

                    -- Compile command using modern C++ standards alongside debug symbols (-g)
                    local compile_cmd = string.format("g++ -std=c++20 -g %s -o %s", current_file, executable)

                    print("Compiling with debug symbols...")
                    local result = vim.fn.system(compile_cmd)

                    -- If compilation fails, show notification and return nil to halt smoothly
                    if vim.v.shell_error ~= 0 then
                        vim.notify("Compilation failed:\n" .. result, vim.log.levels.ERROR)
                        return nil
                    end

                    -- Return the absolute path of the compiled program to start debugging
                    return vim.fn.getcwd() .. "/" .. executable
                end,
                cwd = function()
                    return vim.fn.getcwd()
                end,
                stopOnEntry = false,

                -- FIXED: Tells CodeLLDB to feed input.txt directly into standard input (cin)
                -- Syntax: [ "stdin_source", "stdout_destination" ]
                stdio = { "input.txt", nil },

                -- CHANGED TO FALSE: Since inputs flow silently from input.txt,
                -- we can disable the messy external terminal split layout entirely!
                runInTerminal = false,
            },
        }
        dap.configurations.c = dap.configurations.cpp

        -- Debugging Control Mappings
        vim.keymap.set("n", "<leader>dc", function()
            dap.continue()
        end, { desc = "Debug: Start/Continue" })
        vim.keymap.set("n", "<leader>dn", function()
            dap.step_over()
        end, { desc = "Debug: Step Over (Next)" })
        vim.keymap.set("n", "<leader>di", function()
            dap.step_into()
        end, { desc = "Debug: Step Into" })
        vim.keymap.set("n", "<leader>do", function()
            dap.step_out()
        end, { desc = "Debug: Step Out" })
        vim.keymap.set("n", "<leader>db", function()
            dap.toggle_breakpoint()
        end, { desc = "Debug: Toggle Breakpoint" })
        vim.keymap.set("n", "<leader>du", function()
            dapui.toggle()
        end, { desc = "Debug: Toggle UI" })
        -- Add this line to your keymaps block inside dap.lua:
        vim.keymap.set("n", "<leader>dx", function()
            require("dap").terminate()
            require("dapui").close()
        end, { desc = "Debug: Stop/Terminate Session" })
    end,
}
